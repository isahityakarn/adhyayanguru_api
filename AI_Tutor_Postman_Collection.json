{
  "info": {
    "name": "AI Tutor API",
    "description": "Google Gemini-powered AI Tutor endpoints for StudyYodha",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "YOUR_TOKEN_HERE",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "AI Tutor",
      "item": [
        {
          "name": "Chat - Simple Question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What is the Pythagorean theorem?\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/ai-tutor/chat",
              "host": ["{{base_url}}"],
              "path": ["ai-tutor", "chat"]
            }
          },
          "response": []
        },
        {
          "name": "Chat - With Context",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Can you explain this concept in simple terms?\",\n  \"context\": {\n    \"subject\": \"Physics\",\n    \"chapter\": \"Laws of Motion\",\n    \"topic\": \"Newton's First Law\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/ai-tutor/chat",
              "host": ["{{base_url}}"],
              "path": ["ai-tutor", "chat"]
            }
          },
          "response": []
        },
        {
          "name": "Chat - With History",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Can you give me an example?\",\n  \"context\": {\n    \"subject\": \"Mathematics\",\n    \"chapter\": \"Algebra\",\n    \"topic\": \"Quadratic Equations\"\n  },\n  \"conversation_history\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"What is a quadratic equation?\"\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": \"A quadratic equation is a polynomial equation of degree 2, typically written in the form ax² + bx + c = 0, where a, b, and c are constants and a ≠ 0.\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/ai-tutor/chat",
              "host": ["{{base_url}}"],
              "path": ["ai-tutor", "chat"]
            }
          },
          "response": []
        },
        {
